; GmuxDriver.inf - KMDF driver used to reach the Apple gmux MMIO block on T2 Macs.
; Binds to the ACPI\APP000B node (address taken from its ACPI resource); the old
; root-enumerated virtual node root\GmuxDriver is still listed as a fallback.
;
; $ARCH$, $KMDFVERSION$ and the DriverVer line are rewritten by CI (StampInf).
; Keep this file pure ASCII: non-ASCII bytes in INF comments have caused
; parser/InfVerif problems before.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = GmuxDriver.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
Drivers_Dir    = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
GmuxDriver.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
; Real ACPI node first: PnP then hands the driver the gmux memory range from
; ACPI _CRS (read in EvtDevicePrepareHardware). The root\ ID is kept only for the
; old virtual-node install; do NOT create both nodes at once (they share
; \Device\GmuxCtl and the same MMIO block).
%DeviceDesc%     = GmuxDriver_Device, ACPI\APP000B
%DeviceDescRoot% = GmuxDriver_Device, root\GmuxDriver

[Drivers_Dir]
GmuxDriver.sys

[GmuxDriver_Device.NT]
CopyFiles = Drivers_Dir

[GmuxDriver_Device.NT.Services]
AddService = GmuxDriver, %SPSVCINST_ASSOCSERVICE%, GmuxDriver_Service_Inst

[GmuxDriver_Service_Inst]
DisplayName   = %ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\GmuxDriver.sys

; Without this section the KMDF loader is never told to bind the driver.
[GmuxDriver_Device.NT.Wdf]
KmdfService = GmuxDriver, GmuxDriver_wdfsect

[GmuxDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "Osaul4ik"
DiskName               = "Gmux Driver Installation Disk"
DeviceDesc             = "Apple GMUX Control Device"
DeviceDescRoot         = "Apple GMUX Control Device (root-enumerated)"
ServiceDesc            = "GMUX Control Service"
